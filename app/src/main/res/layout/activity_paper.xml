<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F5F0">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        android:background="@drawable/bg_circle_white"
        android:elevation="6dp"
        android:src="@android:drawable/ic_menu_revert"
        app:tint="#2E7D32"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvGuideTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="16dp"
        android:text="Recycling Guide"
        android:textColor="#2E7D32"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/btnBack"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <!-- TabLayout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        app:tabIndicatorColor="#2E7D32"
        app:tabSelectedTextColor="#2E7D32"
        app:tabTextColor="#888">
        <com.google.android.material.tabs.TabItem android:text="✅ Recyclable" />
        <com.google.android.material.tabs.TabItem android:text="❌ Non-Recyclable" />
        <com.google.android.material.tabs.TabItem android:text="📋 Process" />
    </com.google.android.material.tabs.TabLayout>

    <!-- Content Area -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
        app:layout_constraintTop_toBottomOf="@id/tab_layout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
        <!-- ====================== 1. Recyclable Paper ====================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_recyclable_paper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accepted Paper Types"
                    android:textColor="#2E7D32"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Newspaper &amp; Magazines: Old newsprint and periodicals.\n• Cardboard: Packaging boxes and shipping containers.\n• Copy Paper: Office paper (no need to remove staples).\n• Envelopes: Standard windowless envelopes.\n• Leaflets: Clean promotional flyers and documents."
                    android:lineSpacingExtra="6dp"
                    android:textSize="15sp"
                    android:textColor="#444444"/>

                <!-- 預留圖片位置 -->
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="150dp"
                    android:layout_marginTop="16dp"
                    android:src="@drawable/image_recyclable_paper"
                    android:scaleType="fitCenter"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ====================== 2. Non-Recyclable Paper ====================== -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_non_recyclable_paper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#FFF8F8">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Non-Recyclable Paper"
                    android:textColor="#C62828"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Greasy Paper: Used pizza boxes, food wrappers.\n• Wet Paper: Soaked newspapers or tissues.\n• Laminated Paper: Stickers, plastic-coated food packaging.\n• Composite Items: Thermal receipts, juice cartons (Tetra Pak)."
                    android:lineSpacingExtra="6dp"
                    android:textSize="15sp"
                    android:textColor="#444444"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

            <!-- ====================== 3. Paper Recycling Process ====================== -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_paper_process"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- 標題 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Simplified 4-Step Paper Recycling"
                        android:textStyle="bold"
                        android:textSize="20sp"
                        android:textColor="#1565C0"
                        android:layout_marginBottom="16dp"/>

                    <!-- 步驟 1: Check & Remove -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E3F2FD"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_blue"
                            android:text="1"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="CHECK and REMOVE plastics/glues"
                            android:textStyle="bold"
                            android:textColor="#0D47A1"/>
                    </LinearLayout>

                    <!-- 步驟 2: Clean -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E3F2FD"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_blue"
                            android:text="2"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="KEEP DRY and avoid oil stains"
                            android:textStyle="bold"
                            android:textColor="#0D47A1"/>
                    </LinearLayout>

                    <!-- 步驟 3: Flatten -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E3F2FD"
                        android:padding="12dp"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_blue"
                            android:text="3"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="FLATTEN boxes to save space"
                            android:textStyle="bold"
                            android:textColor="#0D47A1"/>
                    </LinearLayout>

                    <!-- 步驟 4: Sort -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E3F2FD"
                        android:padding="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/bg_circle_blue"
                            android:text="4"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:text="SORT into the BLUE bins"
                            android:textStyle="bold"
                            android:textColor="#0D47A1"/>
                    </LinearLayout>

                    <!-- 步驟示意圖 -->
                    <ImageView
                        android:id="@+id/img_paper_process_guide"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:src="@drawable/image_paper_recycling_steps"
                        android:scaleType="fitCenter"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="16dp"
                        android:foreground="?attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="(Tap to enlarge)"
                        android:gravity="center"
                        android:textSize="12sp"
                        android:textColor="#888888"
                        android:layout_marginTop="4dp" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="16dp"/>

                    <!-- 環保價值 -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Environmental Impact"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#333333"
                        android:layout_marginBottom="8dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="• Saves Trees: 1 ton of paper saves ~17 trees.\n• Conserves Water: Reduces usage by 24,000 liters.\n• Energy Efficiency: Recycling uses 40% less energy."
                        android:lineSpacingExtra="6dp"
                        android:textSize="14sp"
                        android:textColor="#666666"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
    </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <!-- Bottom Navigation  -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/white"
        app:itemIconTint="@color/nav_item_color"
        app:itemTextColor="@color/nav_item_color"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>